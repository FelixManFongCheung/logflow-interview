# Application
APP_ENV=development
PROJECT_NAME="LOGFLOWS Knowledge RAG"
DEBUG=true

# CORS — any frontend origin can call the two JSON endpoints
ALLOWED_ORIGINS="*"

# Chat: DeepSeek R1 reasoning model (paid OpenRouter route — requires account credits)
# Get a key at https://openrouter.ai/keys and paste it below.
OPENROUTER_API_KEY="REPLACE_WITH_YOUR_OPENROUTER_KEY"
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_MODEL=qwen/qwen3-embedding-4b
EMBEDDING_DIMENSIONS=1024
LLM_MODEL=deepseek/deepseek-r1-0528
LLM_TEMPERATURE=0

# Postgres + pgvector
# Host API (`make dev`): POSTGRES_HOST=localhost (Compose publishes db on :5432)
# API in Docker (`make start`): Compose overrides POSTGRES_HOST=db — leave localhost here
# Supabase (optional): Session pooler host, sslmode=require, user=postgres.<project-ref>
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ragdb
POSTGRES_USER=raguser
POSTGRES_PASSWORD=ragpassword
POSTGRES_SSLMODE=prefer

# Retrieval / chunking (ingest uses token settings via app/core/config.py)
CHUNK_SIZE_TOKENS=256
CHUNK_OVERLAP_TOKENS=32
RETRIEVE_K=6
HYBRID_SEMANTIC_WEIGHT=0.5
HYBRID_LEXICAL_WEIGHT=0.5
EVIDENCE_THRESHOLD=0.22
HIGH_CONFIDENCE_THRESHOLD=0.45
