# Application
APP_ENV=development
PROJECT_NAME="LOGFLOWS Knowledge RAG"
DEBUG=true

# CORS — any frontend origin can call the two JSON endpoints
ALLOWED_ORIGINS="*"

# LLM + embeddings (OpenAI-compatible: OpenAI, Azure OpenAI, Qwen, Atlas Cloud)
OPENAI_API_KEY="your-api-key"
# OPENAI_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4.1-mini
LLM_TEMPERATURE=0

# Postgres + pgvector (docker-compose service name is `db` from inside Compose)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ragdb
POSTGRES_USER=raguser
POSTGRES_PASSWORD=ragpassword

# Retrieval
CHUNK_SIZE=900
CHUNK_OVERLAP=120
RETRIEVE_K=6
EVIDENCE_THRESHOLD=0.22
HIGH_CONFIDENCE_THRESHOLD=0.45
