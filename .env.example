# Application
APP_ENV=development
PROJECT_NAME="LOGFLOWS Knowledge RAG"
DEBUG=true

# CORS — any frontend origin can call the two JSON endpoints
ALLOWED_ORIGINS="*"

# LLM + embeddings (OpenAI-compatible). Default is OpenRouter + Qwen (works from Hong Kong).
# Get a key at https://openrouter.ai/keys and paste it below.
OPENROUTER_API_KEY="your-openrouter-api-key"
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_MODEL=qwen/qwen3-embedding-4b
EMBEDDING_DIMENSIONS=1024
LLM_MODEL=google/gemma-4-26b-a4b-it:free
LLM_TEMPERATURE=0

# Postgres + pgvector
# Host API (`make dev`): POSTGRES_HOST=localhost (Compose publishes db on :5432)
# API in Docker (`make start`): Compose overrides POSTGRES_HOST=db — leave localhost here
# Supabase (optional): Session pooler host, sslmode=require, user=postgres.<project-ref>
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ragdb
POSTGRES_USER=raguser
POSTGRES_PASSWORD=ragpassword
POSTGRES_SSLMODE=prefer

# Retrieval
CHUNK_SIZE=900
CHUNK_OVERLAP=120
RETRIEVE_K=6
EVIDENCE_THRESHOLD=0.22
HIGH_CONFIDENCE_THRESHOLD=0.45
