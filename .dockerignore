# Version control
.git
.gitignore
.github

# Secrets stay on the host; Compose injects them at runtime via env_file / -e
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.hypothesis/
pytestdebug.log
*.egg-info/
*.ipynb

# Virtual environments
.venv
venv
ENV/
env/

# Development tools
.idea
.vscode
*.swp
*.swo
.DS_Store

# Logs
logs/
*.log

# Docker metadata is not needed inside the image
.dockerignore
docker-compose.yml

# Docs (keep data/samples/*.md for seeding)
docs/
README.md
AGENTS.md
LICENSE

# Build artifacts
*.pyc
*.pyo
dist/
build/

# Reports
evals/reports/
